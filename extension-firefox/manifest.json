{
  "manifest_version": 3,
  "name": "Screen → Ollama Vision (Página A)",
  "version": "1.0.0",
  "description": "Captura a tela inteira e disponibiliza os frames para análise por um modelo Ollama local com visão computacional.",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Iniciar captura de tela (Página A)"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "screen-ollama-vision@local.pata"
    }
  }
}
